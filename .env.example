# ── BSP Production Environment Template ──
# Copy to .env.local for local dev. Set in Railway/hosting for production.
# Never commit real secrets. Run: npm run secret-scan before commit.

# ── Database (required in production) ──
# Primary variable used by Prisma BSP schema (prisma/bsp.schema.prisma):
BSP_DATABASE_URL="postgresql://bsp:bsp@localhost:5433/bsp?schema=public"
# Legacy root schema only — NOT used by BSP runtime. Railway Postgres plugin
# often exposes DATABASE_URL; copy its value into BSP_DATABASE_URL.
# DATABASE_URL="postgresql://..."

# Connection pool (appended automatically if not in URL)
BSP_DB_POOL_SIZE="10"
BSP_DB_POOL_TIMEOUT="20"

# ── Auth & Admin (required in production) ──
# JWT signing secret — min 32 chars. Code reads BSP_AUTH_SECRET (not AUTH_SECRET).
BSP_AUTH_SECRET="dev-bsp-auth-secret-min-32-chars!!"
# Admin console login — min 8 chars; must not use dev default in production.
BSP_ADMIN_PASSWORD="bsp-admin-dev"

# Demo only — in-memory store (NOT allowed when NODE_ENV=production)
# BSP_USE_MEMORY=1

# ── Runtime modes (production safety) ──
# Explicit demo APIs / pilot demo button. Keep false in production.
BSP_DEMO_MODE=false
# Allow fixture AI/news when external APIs unavailable. Keep false in production.
BSP_ALLOW_FIXTURE=false
# Auto-create demo session on pilot health check. Dev-only; ignored in production.
BSP_PILOT_BOOTSTRAP=false
BSP_PILOT_MODE=
NEXT_PUBLIC_PILOT_MODE=

# ── OpenAI (server-only — never expose to client) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2
OPENAI_ENABLED=true
# Legacy alias (still supported): BSP_OPENAI_API_KEY, BSP_OPENAI_MODEL
# Optional pricing JSON for cost estimates (USD per 1M tokens)
# OPENAI_MODEL_PRICING_JSON={"gpt-4.1-mini":{"inputPer1M":0.4,"outputPer1M":1.6}}

# ── News Provider ──
BSP_NEWS_PROVIDER=google-rss
# google-rss = Google News RSS (free, no API key). gnews = GNews API (requires BSP_GNEWS_API_KEY)
BSP_GNEWS_API_KEY=
NEWS_TIMEOUT_MS=8000
NEWS_MAX_RETRIES=2

# ── External Data ──
BSP_FX_ENABLED=true
BSP_FX_PROVIDER=frankfurter
EXTERNAL_DATA_TIMEOUT_MS=8000

# ── Live integration tests (costs may apply — CI keeps false) ──
RUN_LIVE_API_TESTS=false

# ── Server / Hosting ──
# Railway injects PORT. Custom server binds 0.0.0.0 in production automatically.
NODE_ENV=production
# HOSTNAME=localhost
# PORT=3000
