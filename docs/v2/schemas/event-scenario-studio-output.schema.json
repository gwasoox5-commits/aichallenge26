{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bsp.local/v2/schemas/event-scenario-studio-output.schema.json",
  "title": "EventScenarioStudioOutput",
  "description": "OpenAI Structured Outputs schema for V2.1 Event Scenario Studio. AI draft only — GM approval required before Event Engine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "assumptions",
    "impactPathways",
    "scenarios",
    "uncertainty",
    "economyVariableChanges"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "category", "confidenceLabel", "isEstimate"],
      "properties": {
        "title": { "type": "string", "minLength": 4, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 20, "maxLength": 600 },
        "category": {
          "type": "string",
          "enum": [
            "환율",
            "금리",
            "원자재",
            "공급망",
            "관세",
            "경쟁사",
            "정부정책",
            "자연재해"
          ]
        },
        "confidenceLabel": {
          "type": "string",
          "enum": ["HIGH", "MEDIUM", "LOW"],
          "description": "Qualitative confidence — not a probability"
        },
        "isEstimate": {
          "type": "boolean",
          "description": "true when input lacks detail or effects are inferred"
        },
        "sourcePromptHash": { "type": "string" },
        "targetIndustry": { "type": "string" },
        "targetMarketOrRegion": { "type": "string" },
        "expectedDuration": { "type": "string" },
        "targetPeriodLabel": { "type": "string", "description": "e.g. Y2H1 or P3/6" },
        "analysisIntensity": {
          "type": "string",
          "enum": ["LIGHT", "STANDARD", "DEEP"]
        }
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 5, "maxLength": 300 }
    },
    "impactPathways": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "affectedSteps"],
        "properties": {
          "path": { "type": "string", "maxLength": 400 },
          "affectedSteps": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "LOAN",
                "FACILITY",
                "HIRING",
                "MATERIAL",
                "PRODUCTION",
                "SALES",
                "SETTLEMENT"
              ]
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pessimistic", "neutral", "optimistic"],
      "properties": {
        "pessimistic": { "$ref": "#/$defs/scenarioOutlook" },
        "neutral": { "$ref": "#/$defs/scenarioOutlook" },
        "optimistic": { "$ref": "#/$defs/scenarioOutlook" }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caveats", "educationDisclaimer"],
      "properties": {
        "caveats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string" }
        },
        "educationDisclaimer": {
          "type": "string",
          "description": "Must state scenarios are educational what-if, not forecasts"
        }
      }
    },
    "economyVariableChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pessimistic", "neutral", "optimistic"],
      "properties": {
        "pessimistic": { "$ref": "#/$defs/variableChangeSet" },
        "neutral": { "$ref": "#/$defs/variableChangeSet" },
        "optimistic": { "$ref": "#/$defs/variableChangeSet" }
      }
    }
  },
  "$defs": {
    "studioVariableKey": {
      "type": "string",
      "enum": [
        "interestRate",
        "exchangeRate",
        "rawMaterialCost",
        "logisticsCost",
        "tariff",
        "demand",
        "marketGrowth",
        "inflation",
        "competitionIntensity",
        "energyCost",
        "esgCost",
        "carbonTax",
        "governmentSupport",
        "businessCycleIndex"
      ]
    },
    "effectMode": {
      "type": "string",
      "enum": ["ABSOLUTE", "DELTA", "PERCENT", "MULTIPLY"]
    },
    "variableEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "mode", "value", "rationale"],
      "properties": {
        "key": { "$ref": "#/$defs/studioVariableKey" },
        "mode": { "$ref": "#/$defs/effectMode" },
        "value": { "type": "number" },
        "unit": { "type": "string" },
        "rationale": { "type": "string", "maxLength": 200 },
        "isEstimate": { "type": "boolean" }
      }
    },
    "variableChangeSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effects"],
      "properties": {
        "effects": {
          "type": "array",
          "maxItems": 14,
          "items": { "$ref": "#/$defs/variableEffect" }
        }
      }
    },
    "scenarioOutlook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "narrative", "rationale", "discussionQuestions", "newsHeadline", "newsArticleBody", "severity"],
      "properties": {
        "label": { "type": "string" },
        "narrative": { "type": "string", "minLength": 30, "maxLength": 800 },
        "rationale": { "type": "string", "minLength": 20, "maxLength": 500 },
        "discussionQuestions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string" }
        },
        "newsHeadline": { "type": "string", "minLength": 10, "maxLength": 160 },
        "newsArticleBody": { "type": "string", "minLength": 40, "maxLength": 1200 },
        "severity": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        }
      }
    }
  }
}
